ESX = exports['es_extended']:getSharedObject()

---@class DrugItem
---@field item string Drug item name
---@field label string Display label
---@field amount number Quantity available

--- Client state variables
local PlayerData = {}
local myDrugs = {} ---@type DrugItem[]
local isSelling = false
local startLocation = nil
local copCount = 0
local currentTarget = nil
local currentZone = nil ---@type string|nil
local zoneData = {} ---@type table<string, table>

--- Cache for performance
local cache = {
  ped = PlayerPedId(),
  coords = GetEntityCoords(PlayerPedId())
}

--- Update cache periodically
CreateThread(function()
  while true do
    Wait(500)
    cache.ped = PlayerPedId()
    cache.coords = GetEntityCoords(cache.ped)
  end
end)

--- Update drug holdings periodically for ox_target
CreateThread(function()
  -- Wait for ESX and Config to load
  while not ESX or not Config do
    Wait(1000)
  end

  while true do
    Wait(5000) -- Check every 5 seconds

    if not isSelling then
      ESX.TriggerServerCallback('drp-drugs:server:getAvailableDrugs', function(availableDrugs)
        myDrugs = availableDrugs or {}
      end)
    end
  end
end)

--- Debug print helper
---@param message string Debug message
local function debugPrint(message)
  if Config and Config.Debug then
    print('^3[DRP-DRUGS DEBUG]^7 ' .. message)
  end
end

--- Debug notification helper
---@param message string Debug notification message
local function debugNotify(message)
  if Config and Config.Debug then
    lib.notify({
      title = 'DEBUG',
      description = message,
      type = 'inform',
      duration = 3000
    })
  end
end

--- Load configuration from server
local function loadConfig()
  ESX.TriggerServerCallback('drp-drugs:server:getConfig', function(config)
    Config = config
    debugPrint('Config loaded from server')
    debugPrint('Debug mode: ' .. tostring(Config.Debug))

    -- Initialize ox_lib zones
    for zoneName, zoneConfig in pairs(Config.Zones) do
      -- Convert vector2 points to vector3 using minZ
      local points3d = {}
      for i, point in ipairs(zoneConfig.points) do
        points3d[i] = vector3(point.x, point.y, zoneConfig.options.minZ)
      end

      zoneData[zoneName] = lib.zones.poly({
        name = zoneName,
        points = points3d,
        thickness = zoneConfig.options.maxZ - zoneConfig.options.minZ,
        onEnter = function()
          currentZone = zoneName
          debugPrint('Entered zone: ' .. zoneName)
          debugNotify('Entered selling zone: ' .. zoneName)
        end,
        onExit = function()
          if currentZone == zoneName then
            currentZone = nil
            debugPrint('Exited zone: ' .. zoneName)
            debugNotify('Exited selling zone: ' .. zoneName)
          end
        end
      })
    end
  end)
end

--- Initialize player data
RegisterNetEvent('esx:playerLoaded', function(xPlayer)
  PlayerData = xPlayer

  -- Initialize drug holdings for ox_target (delayed)
  CreateThread(function()
    Wait(2000)
    if ESX then
      ESX.TriggerServerCallback('drp-drugs:server:getAvailableDrugs', function(availableDrugs)
        myDrugs = availableDrugs or {}
        debugPrint('Player loaded - drug holdings: ' .. #myDrugs .. ' types')
      end)
    end
  end)
end)

RegisterNetEvent('esx:setJob', function(job)
  PlayerData.job = job
end)

AddEventHandler('onResourceStart', function(resourceName)
  if GetCurrentResourceName() ~= resourceName then return end
  PlayerData = ESX.GetPlayerData()
  loadConfig()

  -- Initialize drug holdings for ox_target (delayed)
  CreateThread(function()
    Wait(2000)
    if ESX then
      ESX.TriggerServerCallback('drp-drugs:server:getAvailableDrugs', function(availableDrugs)
        myDrugs = availableDrugs or {}
        debugPrint('Initialized drug holdings: ' .. #myDrugs .. ' types')
      end)
    end
  end)
end)

CreateThread(function()
  loadConfig()

  -- Initialize drug holdings for ox_target (delayed)
  Wait(2000)
  if ESX then
    ESX.TriggerServerCallback('drp-drugs:server:getAvailableDrugs', function(availableDrugs)
      myDrugs = availableDrugs or {}
      debugPrint('Initialized drug holdings: ' .. #myDrugs .. ' types')
    end)
  end
end)

--- Get current territory player is in
---@return string|nil territory Territory name or nil
---@return table|nil zoneConfig Zone configuration
local function getCurrentTerritory()
  if not currentZone then return nil, nil end
  return currentZone, Config.Zones[currentZone]
end

--- Start selling drugs
local function startSelling()
  LocalPlayer.state:set("inv_busy", true, true)
  lib.notify({
    description = 'Started selling drugs',
    type = 'success'
  })
  startLocation = cache.coords
  isSelling = true

  debugPrint('Started selling at: ' .. tostring(startLocation))
  debugPrint('Available drugs: ' .. #myDrugs)
  for _, drug in ipairs(myDrugs) do
    debugPrint('  - ' .. drug.label .. ' x' .. drug.amount)
  end
end

--- Stop selling drugs
local function stopSelling()
  isSelling = false
  LocalPlayer.state:set("inv_busy", false, true)
  lib.notify({
    description = 'Stopped selling drugs',
    type = 'inform'
  })
  startLocation = nil

  debugPrint('Stopped selling drugs')
end

--- Draw 3D text at coordinates
---@param coords vector3 World coordinates
---@param text string Text to display
local function draw3DText(coords, text)
  local onScreen, screenX, screenY = World3dToScreen2d(coords.x, coords.y, coords.z)

  if onScreen then
    SetTextScale(0.35, 0.35)
    SetTextFont(4)
    SetTextProportional(true)
    SetTextColour(255, 255, 255, 215)
    SetTextEntry("STRING")
    SetTextCentre(true)
    AddTextComponentString(text)
    DrawText(screenX, screenY)
  end
end

--- Sell drugs to NPC
---@param ped number NPC entity handle
local function sellDrugs(ped)
  currentTarget = ped

  -- Random fail chance
  local failChance = math.random(1, 20)
  if failChance <= Config.SellDifficulty then
    Wait(1500)
    currentTarget = nil
    return
  end

  if not myDrugs or #myDrugs == 0 then
    currentTarget = nil
    return
  end

  -- Get current territory and its config
  local territory, zoneConfig = getCurrentTerritory()
  if not territory or not zoneConfig then
    currentTarget = nil
    return
  end

  -- Select random drug from inventory
  local drugIndex = math.random(1, #myDrugs)
  local currentDrug = myDrugs[drugIndex]
  local bagAmount = math.random(1, 2)
  if currentDrug.amount == 1 then bagAmount = 1 end

  -- Calculate price with zone modifier
  local priceData = Config.Drugs[currentDrug.item].price
  local basePrice = math.random(priceData.min, priceData.max)
  local copBonus = math.random(60, 100) * copCount
  local price = math.floor((basePrice + copBonus) * bagAmount * zoneConfig.priceMod)

  -- Apply 2x multiplier if in 2x zone
  if zoneConfig.is2x then
    price = price * 2
  end

  -- Apply weekend bonus (Friday=5, Saturday=6, Sunday=0)
  local dayOfWeek = GetClockDayOfWeek()
  local isWeekend = (dayOfWeek == 5 or dayOfWeek == 6 or dayOfWeek == 0)
  if isWeekend and Config.WeekendPriceBonus then
    price = math.floor(price * Config.WeekendPriceBonus)
  end

  -- Check if NPC will steal instead
  local willSteal = false
  if zoneConfig.stealChance then
    local stealRoll = math.random()
    if stealRoll <= zoneConfig.stealChance then
      willSteal = true
    end
  end

  -- Debug transaction info
  debugPrint('=== Drug Sale Attempt ===')
  debugPrint('Drug: ' .. currentDrug.label .. ' x' .. bagAmount)
  debugPrint('Territory: ' .. territory .. ' (Modifier: ' .. zoneConfig.priceMod .. 'x)')
  debugPrint('Base Price: $' .. basePrice)
  debugPrint('Cop Bonus: $' .. copBonus)
  debugPrint('Final Price: $' .. price)
  debugPrint('2x Zone: ' .. tostring(zoneConfig.is2x or false))
  debugPrint('Weekend Bonus: ' .. tostring(isWeekend))
  debugPrint('Will Steal: ' .. tostring(willSteal))

  SetPedAsNoLongerNeeded(ped)
  ClearPedTasks(ped)

  -- Make NPC walk to player
  TaskGoStraightToCoord(ped, cache.coords.x, cache.coords.y, cache.coords.z, 1.2, -1, 0.0, 0.0)

  local targetDist = #(cache.coords - GetEntityCoords(ped))
  while targetDist > 1.5 and isSelling do
    Wait(100)
    local pedCoords = GetEntityCoords(ped)
    TaskGoStraightToCoord(ped, cache.coords.x, cache.coords.y, cache.coords.z, 1.2, -1, 0.0, 0.0)
    targetDist = #(cache.coords - pedCoords)
  end

  -- NPC reached player
  TaskLookAtEntity(ped, cache.ped, 5500.0, 2048, 3)
  TaskTurnPedToFaceEntity(ped, cache.ped, 5500)
  TaskStartScenarioInPlace(ped, "WORLD_HUMAN_STAND_IMPATIENT_UPRIGHT", 0, false)

  -- Interaction loop
  while targetDist < 1.5 and isSelling and currentTarget do
    Wait(0)
    local pedCoords = GetEntityCoords(ped)
    targetDist = #(cache.coords - pedCoords)

    -- Build display text
    local displayText = ''

    -- Add weekend indicator (green color)
    if isWeekend then
      displayText = '~g~[WEEKEND]~w~ '
    end

    -- Add 2x indicator if in 2x zone (yellow color)
    if zoneConfig.is2x then
      displayText = displayText .. '~y~2x~w~ '
    end

    -- Add offer text
    if willSteal then
      displayText = displayText .. '~g~E~w~ ' .. bagAmount .. 'x ' .. currentDrug.label .. ' ~r~(STEALING)~w~ / ~g~G~w~ Decline'
    else
      displayText = displayText .. '~g~E~w~ ' .. bagAmount .. 'x ' .. currentDrug.label .. ' for $' .. price .. ' / ~g~G~w~ Decline'
    end

    draw3DText(pedCoords, displayText)

    -- Accept offer (E key)
    if IsControlJustPressed(0, 38) then
      Entity(currentTarget).state.bought_drugs = true

      -- Clear NPC tasks first, then freeze
      ClearPedTasks(currentTarget)
      Wait(100)
      FreezeEntityPosition(currentTarget, true)

      -- Request and wait for animations to load
      RequestAnimDict('mp_common')
      while not HasAnimDictLoaded('mp_common') do
        Wait(10)
      end

      -- Start both animations at the exact same time with same parameters
      TaskPlayAnim(cache.ped, 'mp_common', 'givetake1_a', 8.0, 8.0, 3000, 48, 0, false, false, false)
      TaskPlayAnim(currentTarget, 'mp_common', 'givetake1_b', 8.0, 8.0, 3000, 48, 0, false, false, false)

      -- Progress circle during transaction
      local success = lib.progressCircle({
        duration = 3000,
        position = 'bottom',
        label = willSteal and 'Getting robbed...' or 'Exchanging drugs...',
        useWhileDead = false,
        canCancel = false,
        disable = {
          car = true,
          move = true,
          combat = true,
        }
      })

      ClearPedTasks(cache.ped)

      if success then
        -- Trigger server sale
        TriggerServerEvent('drp-drugs:server:sell', currentDrug.item, bagAmount, price, territory, willSteal)

        debugPrint('Sale completed!')
        if willSteal then
          debugPrint('Drugs were STOLEN!')
        else
          debugPrint('Payment received: $' .. price)
        end

        -- Check for police alert
        local snitchRoll = math.random()
        if snitchRoll <= zoneConfig.snitchChance then
          local streetHash, crossingHash = GetStreetNameAtCoord(cache.coords.x, cache.coords.y, cache.coords.z)
          local streetName = GetStreetNameFromHashKey(streetHash)

          debugPrint('!!! POLICE ALERTED !!! (Snitch Roll: ' .. snitchRoll .. ' <= ' .. zoneConfig.snitchChance .. ')')
          debugNotify('Police have been alerted!')

          TriggerServerEvent('drp-drugs:server:policeAlert', {
            coords = cache.coords,
            street = streetName
          })
        else
          debugPrint('No police alert (Snitch Roll: ' .. snitchRoll .. ' > ' .. zoneConfig.snitchChance .. ')')
        end
      end

      -- Cleanup NPC smoothly
      FreezeEntityPosition(currentTarget, false)
      SetPedAsNoLongerNeeded(currentTarget)
      currentTarget = nil

      break
    end

    -- Decline offer (G key)
    if IsControlJustPressed(0, 47) then
      lib.notify({
        description = 'Offer declined',
        type = 'error'
      })
      SetPedKeepTask(currentTarget, false)
      SetEntityAsNoLongerNeeded(currentTarget)
      ClearPedTasksImmediately(currentTarget)
      currentTarget = nil
      break
    end
  end

  if currentTarget then
    currentTarget = nil
  end
end

--- Main selling thread
local function sellingThread()
  CreateThread(function()
    while isSelling do
      Wait(50)

      if not startLocation then break end

      -- Check distance from start location
      local distanceFromStart = #(cache.coords - startLocation)
      if distanceFromStart > 25.0 then
        stopSelling()
        break
      end

      -- Find nearby NPCs to sell to
      if not currentTarget then
        -- Get list of player peds to ignore
        local ignorePeds = {}
        for _, player in ipairs(GetActivePlayers()) do
          ignorePeds[#ignorePeds + 1] = GetPlayerPed(player)
        end

        -- Find closest NPC
        local closestPed = nil
        local closestDist = 20.0

        for ped in EnumeratePeds() do
          if not table.contains(ignorePeds, ped) and DoesEntityExist(ped) and not Entity(ped).state.bought_drugs then
            local pedCoords = GetEntityCoords(ped)
            local dist = #(cache.coords - pedCoords)

            if dist < closestDist then
              closestPed = ped
              closestDist = dist
            end
          end
        end

        if closestPed then
          sellDrugs(closestPed)
        end
      end
    end
  end)
end

--- Enumerate all peds in the world
---@return function iterator Ped iterator
function EnumeratePeds()
  return coroutine.wrap(function()
    local handle, ped = FindFirstPed()
    local success

    repeat
      coroutine.yield(ped)
      success, ped = FindNextPed(handle)
    until not success

    EndFindPed(handle)
  end)
end

--- Check if table contains value
---@param tbl table Table to search
---@param val any Value to find
---@return boolean contains Whether value is in table
function table.contains(tbl, val)
  for _, v in ipairs(tbl) do
    if v == val then
      return true
    end
  end
  return false
end

-- Event: Start/stop selling
RegisterNetEvent('drp-drugs:client:toggleSelling', function()
  ESX.TriggerServerCallback('drp-drugs:server:getPoliceCount', function(policeCount)
    if policeCount < Config.PoliceRequired then
      lib.notify({
        description = 'Not enough police on duty (' .. Config.PoliceRequired .. ' required)',
        type = 'error'
      })
      return
    end

    copCount = policeCount

    ESX.TriggerServerCallback('drp-drugs:server:getAvailableDrugs', function(availableDrugs)
      if not availableDrugs then
        lib.notify({
          description = 'You have no drugs to sell',
          type = 'error'
        })
        LocalPlayer.state:set("inv_busy", false, true)
        return
      end

      myDrugs = availableDrugs

      if not isSelling then
        -- Check if in a valid territory
        local territory = getCurrentTerritory()
        if not territory then
          lib.notify({
            description = 'You need to be in a selling zone',
            type = 'error'
          })
          return
        end

        startSelling()
        sellingThread()
      else
        stopSelling()
      end
    end)
  end)
end)

-- Event: Update player's drug holdings
RegisterNetEvent('drp-drugs:client:updateHoldings', function(updatedDrugs)
  myDrugs = updatedDrugs or {}

  -- Stop selling if no drugs left
  if #myDrugs == 0 and isSelling then
    stopSelling()
    lib.notify({
      description = 'You have no more drugs to sell',
      type = 'error'
    })
  end
end)

-- Event: Police alert (for police players)
RegisterNetEvent('drp-drugs:client:policeAlert', function(data)
  if PlayerData.job?.name ~= 'police' then return end

  lib.notify({
    title = '10-31 - Drug Sales',
    description = ('Suspicious activity reported\n%s last seen at %s'):format(data.gender, data.street),
    type = 'inform',
    duration = 10000
  })

  -- Create blip for 5 minutes
  local blip = AddBlipForCoord(data.coords.x, data.coords.y, data.coords.z)
  SetBlipSprite(blip, 514)
  SetBlipScale(blip, 1.0)
  SetBlipColour(blip, 1)
  SetBlipAlpha(blip, 200)
  SetBlipAsShortRange(blip, false)
  BeginTextCommandSetBlipName("STRING")
  AddTextComponentString("Drug Sales")
  EndTextCommandSetBlipName(blip)

  -- Remove blip after 5 minutes
  SetTimeout(5 * 60 * 1000, function()
    RemoveBlip(blip)
  end)
end)

--- Sell drugs via ox_target (outside zones)
---@param data table Target data with entity
local function sellDrugsTarget(data)
  if not Config.OutsideZone.enabled then return end

  local ped = data.entity
  if not DoesEntityExist(ped) or Entity(ped).state.bought_drugs then return end

  -- Check police count
  ESX.TriggerServerCallback('drp-drugs:server:getPoliceCount', function(policeCount)
    if policeCount < Config.PoliceRequired then
      lib.notify({
        description = 'Not enough police on duty (' .. Config.PoliceRequired .. ' required)',
        type = 'error'
      })
      return
    end

    -- Get available drugs
    ESX.TriggerServerCallback('drp-drugs:server:getAvailableDrugs', function(availableDrugs)
      if not availableDrugs or #availableDrugs == 0 then
        lib.notify({
          description = 'You have no drugs to sell',
          type = 'error'
        })
        return
      end

      -- Select random drug
      local drugIndex = math.random(1, #availableDrugs)
      local currentDrug = availableDrugs[drugIndex]
      local bagAmount = math.random(1, 2)
      if currentDrug.amount == 1 then bagAmount = 1 end

      -- Calculate price with OutsideZone multiplier (70% of base)
      local priceData = Config.Drugs[currentDrug.item].price
      local basePrice = math.random(priceData.min, priceData.max)
      local copBonus = math.random(60, 100) * policeCount
      local price = math.floor((basePrice + copBonus) * bagAmount * Config.OutsideZone.priceMultiplier)

      -- Apply weekend bonus
      local dayOfWeek = GetClockDayOfWeek()
      local isWeekend = (dayOfWeek == 5 or dayOfWeek == 6 or dayOfWeek == 0)
      if isWeekend and Config.WeekendPriceBonus then
        price = math.floor(price * Config.WeekendPriceBonus)
      end

      -- Check if NPC will steal
      local willSteal = false
      local stealRoll = math.random()
      if stealRoll <= Config.OutsideZone.stealChance then
        willSteal = true
      end

      debugPrint('=== ox_target Sale Attempt ===')
      debugPrint('Drug: ' .. currentDrug.label .. ' x' .. bagAmount)
      debugPrint('Location: OUTSIDE ZONE (ox_target)')
      debugPrint('Base Price: $' .. basePrice)
      debugPrint('Multiplier: ' .. Config.OutsideZone.priceMultiplier .. 'x (30% penalty)')
      debugPrint('Final Price: $' .. price)
      debugPrint('Will Steal: ' .. tostring(willSteal))

      Entity(ped).state.bought_drugs = true

      -- Clear NPC tasks first, then freeze
      ClearPedTasks(ped)
      Wait(100)
      FreezeEntityPosition(ped, true)

      -- Request and wait for animations to load
      RequestAnimDict('mp_common')
      while not HasAnimDictLoaded('mp_common') do
        Wait(10)
      end

      -- Start both animations at the exact same time with same parameters
      TaskPlayAnim(cache.ped, 'mp_common', 'givetake1_a', 8.0, 8.0, 3000, 48, 0, false, false, false)
      TaskPlayAnim(ped, 'mp_common', 'givetake1_b', 8.0, 8.0, 3000, 48, 0, false, false, false)

      -- Progress circle during transaction
      local success = lib.progressCircle({
        duration = 3000,
        position = 'bottom',
        label = willSteal and 'Getting robbed...' or 'Exchanging drugs...',
        useWhileDead = false,
        canCancel = false,
        disable = {
          car = true,
          move = true,
          combat = true,
        }
      })

      -- Clear player animation
      ClearPedTasks(cache.ped)

      if success then
        -- If stolen, mark ped with stolen state for recovery
        if willSteal then
          Entity(ped).state.stole_drugs = {
            item = currentDrug.item,
            amount = bagAmount,
            time = GetGameTimer()
          }
        end

        -- Trigger server sale with 'outside_zone' territory
        TriggerServerEvent('drp-drugs:server:sell', currentDrug.item, bagAmount, price, 'outside_zone', willSteal)

        debugPrint('ox_target sale completed!')
        if willSteal then
          debugPrint('Drugs were STOLEN!')
        else
          debugPrint('Payment received: $' .. price)
        end

        -- Check for police alert (higher chance outside zones)
        local snitchRoll = math.random()
        if snitchRoll <= Config.OutsideZone.snitchChance then
          local streetHash, crossingHash = GetStreetNameAtCoord(cache.coords.x, cache.coords.y, cache.coords.z)
          local streetName = GetStreetNameFromHashKey(streetHash)

          debugPrint('!!! POLICE ALERTED !!! (Snitch Roll: ' .. snitchRoll .. ' <= ' .. Config.OutsideZone.snitchChance .. ')')
          debugNotify('Police have been alerted!')

          TriggerServerEvent('drp-drugs:server:policeAlert', {
            coords = cache.coords,
            street = streetName
          })
        else
          debugPrint('No police alert (Snitch Roll: ' .. snitchRoll .. ' > ' .. Config.OutsideZone.snitchChance .. ')')
        end
      end

      -- NOW clear ped tasks and unfreeze
      Wait(500)
      ClearPedTasks(ped)
      FreezeEntityPosition(ped, false)

      -- Make them walk away if not stolen (if stolen, player can target them)
      if not willSteal then
        SetPedAsNoLongerNeeded(ped)
      end
    end)
  end)
end

--- Recover stolen drugs from NPC
---@param data table Target data with entity
local function recoverStolenDrugs(data)
  local ped = data.entity
  local stolenData = Entity(ped).state.stole_drugs

  if not stolenData then return end

  -- Check if recovery window expired (60 seconds)
  local timeSinceSteal = GetGameTimer() - stolenData.time
  if timeSinceSteal > 60000 then
    Entity(ped).state.stole_drugs = nil
    lib.notify({
      description = 'The thief already sold your drugs',
      type = 'error'
    })
    return
  end

  FreezeEntityPosition(ped, true)

  local success = lib.progressCircle({
    duration = 2000,
    position = 'bottom',
    label = 'Taking drugs back...',
    useWhileDead = false,
    canCancel = true,
    disable = {
      car = true,
      move = true,
      combat = true,
    }
  })

  if success then
    -- Give drugs back to player
    TriggerServerEvent('drp-drugs:server:recoverDrugs', stolenData.item, stolenData.amount)
    Entity(ped).state.stole_drugs = nil

    lib.notify({
      description = 'You recovered your drugs!',
      type = 'success'
    })

    debugPrint('Recovered ' .. stolenData.amount .. 'x ' .. stolenData.item .. ' from thief')

    -- Make ped flee
    ClearPedTasks(ped)
    FreezeEntityPosition(ped, false)
    TaskSmartFleePed(ped, cache.ped, 100.0, -1, false, false)
    SetPedAsNoLongerNeeded(ped)
  else
    FreezeEntityPosition(ped, false)
  end
end

--- Setup ox_target for NPC drug sales
local function setupOxTarget()
  if not Config or not Config.OutsideZone.enabled then return end

  debugPrint('Setting up ox_target for NPC drug sales')

  exports.ox_target:addGlobalPed({
    {
      name = 'drp_drugs_sell_target',
      icon = 'fas fa-pills',
      label = 'Sell Drugs',
      onSelect = sellDrugsTarget,
      canInteract = function(entity, coords, dist)
        -- Only show if player has drugs and NOT in a zone and NOT already selling
        if isSelling or currentZone then return false end
        if Entity(entity).state.bought_drugs then return false end
        if Entity(entity).state.stole_drugs then return false end
        if IsPedAPlayer(entity) or IsPedDeadOrDying(entity, true) then return false end

        return myDrugs and #myDrugs > 0
      end,
      distance = 2.0
    },
    {
      name = 'drp_drugs_recover_target',
      icon = 'fas fa-hand-rock',
      label = 'Take Drugs Back',
      onSelect = recoverStolenDrugs,
      canInteract = function(entity, coords, dist)
        if IsPedAPlayer(entity) or IsPedDeadOrDying(entity, true) then return false end
        local stolenData = Entity(entity).state.stole_drugs
        if not stolenData then return false end

        -- Check if still within recovery window
        local timeSinceSteal = GetGameTimer() - stolenData.time
        return timeSinceSteal <= 60000
      end,
      distance = 2.0
    }
  })
end

-- Setup ox_target when config loads
AddEventHandler('onResourceStart', function(resourceName)
  if GetCurrentResourceName() ~= resourceName then return end
  Wait(1000) -- Wait for config to load
  setupOxTarget()
end)

-- Also setup after config loads
RegisterNetEvent('esx:playerLoaded', function()
  Wait(1000)
  setupOxTarget()
end)

-- Command: Toggle corner selling
RegisterCommand('cornersell', function()
  TriggerEvent('drp-drugs:client:toggleSelling')
end, false)

-- Command: Sell drugs (alias for testing)
RegisterCommand('sell', function()
  TriggerEvent('drp-drugs:client:toggleSelling')
end, false)
